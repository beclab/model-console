# Copy to .env and edit. Anything not set here falls back to the
# defaults baked into deploy/compose/<engine>.yml. Variables marked
# REQUIRED have no default and the compose stack will fail without them.
#
# v1.1.0 BREAKING. The configuration surface was overhauled. Three
# previously-separate areas collapse into a single canonical form each:
#
#   1. Model source       -> single MODEL_SOURCE env, containing one source
#                            or comma-separated hf:// / ollama:// /
#                            https?:// sources.
#   2. Engine startup     -> single ENGINE_ARGS env in engine-native syntax
#                            (KEY=VAL list for ollama, --flag for
#                            vLLM/SGLang, dual-track for llama.cpp).
#   3. Model capability   -> MODEL_MODE
#                            (chat|embedding|audio|translate|ocr|rerank, required) plus
#                            optional MODEL_SUPPORTS seed the model-spec
#                            on first boot. The resolved spec persists to
#                            MODEL_SPEC_PATH (default ${RUN_DIR}/model-spec.json)
#                            and is then editable via the dashboard API tab
#                            (PUT /api/model-spec). To ship a fuller spec
#                            (label/context_size/pricing), mount a file and
#                            point MODEL_SPEC_PATH at it (disk wins).
#
# llm-init only reads the documented envs (MODEL_SOURCE / ENGINE_ARGS /
# MODEL_NAME / MODEL_MODE / MODEL_SUPPORTS / TRANSLATE_* + runtime knobs below).
# Anything else on the process env is ignored.

# ---------- llm-init image -------------------------------------------
# Production deployments should pin to a specific semver tag.
LLM_INIT_IMAGE=docker.io/beclab/llm-init:v1.2.1
LLM_INIT_PORT=8080

# ---------- model identity -------------------------------------------
# REQUIRED. MODEL_NAME is the alias OpenAI clients send in the "model"
# field; it seeds spec.name. MODEL_MODE
# (chat|embedding|audio|translate|ocr) is
# REQUIRED and seeds spec.mode. MODEL_SUPPORTS is an optional
# comma-separated list of enabled capability keys (anything not listed
# defaults to false), e.g.
# `supports_reasoning,supports_vision`. On first boot these seed the
# model-spec; afterwards MODEL_SPEC_PATH (default ${RUN_DIR}/model-spec.json)
# is the source of truth and is editable via the dashboard.
MODEL_NAME=qwen2.5-7b-instruct
MODEL_MODE=chat
# MODEL_SUPPORTS=supports_reasoning,supports_vision
# Translate is its own mode; the MTran routes mount from it, not from a support:
# MODEL_MODE=translate
# Audio uses the single mode=audio. Advertise direction with supports:
# MODEL_MODE=audio
# MODEL_SUPPORTS=supports_stt             # transcription
# MODEL_SUPPORTS=supports_tts             # speech synthesis
# MODEL_SUPPORTS=supports_audio_s2s       # true speech-to-speech

# ---------- model source ---------------------------------------------
# REQUIRED. Single-source form is the common case. Pick one prefix:
#
#   hf://<owner>/<repo> [--revision <sha>] [--include <file>]
#       Hugging Face repo. For llama.cpp single-GGUF, add
#       --include <file>. The --endpoint flag is BLACKLISTED here;
#       use HF_ENDPOINT below for mirror selection.
#
#   ollama://<library-tag>
#       Ollama Library tag. Daemon pulls; no LOCAL needed.
#
#   ollama://<URL>
#       Ollama URL-overload mode. llm-init range-downloads the GGUF
#       and POSTs it to ollama /api/blobs + /api/create.
#       Auto-detection: dot + slash in the body -> URL form;
#       otherwise -> Library tag.
#
#   https://...[#sha256=<hex>]   |   http://...
#       Direct URL. Sha256 fragment is optional. Requires
#       MODEL_SOURCE_LOCAL to specify the on-disk landing path.
MODEL_SOURCE=hf://Qwen/Qwen2.5-7B-Instruct
# MODEL_SOURCE_LOCAL=/cache/manual/qwen.gguf       # only for https?:// sources

# Multiple sources: the first binds the engine; later sources preload only.
# MODEL_SOURCE=hf://Qwen/Qwen2.5-7B-Instruct,https://example.com/aux.gguf#sha256=abc...
# MODEL_SOURCE_LOCAL=,/cache/aux.gguf
#
# A comma separates sources only when the following optional whitespace
# ends at hf://, ollama://, http://, or https://. Other commas remain in
# the current value. MODEL_SOURCE_LOCAL must have the same number of
# positions; use empty placeholders for non-URL sources.
#
# A llama.cpp vision projector is the one source that is neither main nor
# preload: mark its hf:// segment with --role mmproj. It is downloaded
# inline next to the main weights and stays out of extra_model_path, so
# model_path still points at the main GGUF.
# MODEL_SOURCE=hf://org/vlm --include model.gguf,hf://org/vlm --include mmproj.gguf --role mmproj

# ---------- HF deployment-level env ----------------------------------
# Mirror endpoint applies to every hf:// source. Empty -> default
# https://huggingface.co. Common alternatives: https://hf-mirror.com.
HF_ENDPOINT=https://huggingface.co
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx     # gated/private repos

# ---------- engine startup parameters --------------------------------
# Single env in engine-native syntax. llm-init container and engine
# container both receive the same value; llm-init parses by ENGINE_KIND,
# the engine wrapper transforms it into the native command line / env.
#
# Examples (uncomment ONE, matching the chosen ENGINE_KIND):
#
# Ollama (KEY=VALUE list of OLLAMA_* daemon env):
# ENGINE_ARGS=OLLAMA_NUM_CTX=8192 OLLAMA_KEEP_ALIVE=30m OLLAMA_NUM_PARALLEL=2
#
# vLLM (cmdline):
# ENGINE_ARGS=--max-model-len 8192 --gpu-memory-utilization 0.9 --kv-cache-dtype fp8
#
# llama.cpp (cmdline OR LLAMA_ARG_* env; auto-detected):
# ENGINE_ARGS=-c 8192 -ngl all -ctk q8_0 -fa on
# ENGINE_ARGS=LLAMA_ARG_CTX_SIZE=8192 LLAMA_ARG_N_GPU_LAYERS=all
#
# SGLang (cmdline):
# ENGINE_ARGS=--mem-fraction-static 0.8 --max-running-requests 256 --tp 1
#
# Embed / Audio / OCR / Rerank (Model Console side): do NOT set ENGINE_ARGS.
# Embed uses MODEL_ID + EMBED_* env.
# Rerank uses MODEL_ID + ACCELERATOR + RERANK_* env (MODEL_DIR from wrapper).
# Audio: do NOT set ENGINE_ARGS (audio-engine owns its startup env).
# OCR puts llama.cpp flags on the llamacpp service only (see below).
#
# Unknown tokens are silently passed through to the engine (not an
# error). Use engine-native syntax and only pass keys supported by the engine
# tables and parser semantics.
ENGINE_ARGS=

# ---------- engine ports ---------------------------------------------
# Per-stack overrides. Each compose file sets ENGINE_KIND to its own
# engine and exposes the upstream port internally on the compose
# network -- only llm-init's port is reachable from the host.
VLLM_PORT=8000
# Audio uses the fixed internal upstream http://audio-engine:8000.
# vLLM engine image (deploy/compose/vllm.yml). Default v0.20.1 targets CUDA 13.
# VLLM_IMAGE=vllm/vllm-openai:v0.20.1-cu129              # CUDA 12.9 GPU hosts
# VLLM_IMAGE=vllm/vllm-openai-cpu:v0.24.0-x86_64         # CPU (x86_64, cgroup-aware)
# VLLM_IMAGE=vllm/vllm-openai-cpu:v0.24.0-arm64          # CPU (arm64)
# VLLM_GPU_COUNT=0                                       # required with CPU image / no GPU
# VLLM_MEM_LIMIT=32G                                     # CPU: 0.92×32GiB ≤ ~30GiB host available
SGLANG_PORT=30000
# SGLang engine image (deploy/compose/sglang.yml). Default v0.5.11 needs CUDA 13.
# SGLANG_IMAGE=lmsysorg/sglang:v0.5.11-cu129-runtime   # CUDA 12.9 slim (broken: missing distro)
# SGLANG_IMAGE=lmsysorg/sglang:v0.5.11-cu129             # CUDA 12.9 full (recommended on CUDA 12 hosts)
LLAMACPP_PORT=8081       # 8080 is taken by llm-init
EMBED_PORT=8080          # Embed engine (llm-init stays on 8080)
RERANK_PORT=8080         # Rerank engine (llm-init stays on 8080)
# RERANK_ENGINE_PORT=18082 # host-network integration overlay (rerank.integration.yml)
# OCRAdapter listens on 8080 inside the compose network (not published).

# ---------- Translate (llama.cpp + MTran root routes) ----------------
# This template is an unreleased strict-mode contract: v1.2.1 cannot run it.
# It uses TRANSLATE_LLM_INIT_IMAGE independently, so the common
# LLM_INIT_IMAGE above cannot override it. First run `make docker` in this
# checkout; after strict mode is released, replace only this value with its
# fixed tag.
TRANSLATE_LLM_INIT_IMAGE=llm-init:local
# Then use: docker compose -f deploy/compose/translate.yml --env-file .env up
#
# MODEL_MODE=translate
# TRANSLATE_LANGUAGES=en,zh-Hans
# TRANSLATE_PAIRS=en:zh-Hans,zh-Hans:en
# Clients use /languages, /translate, /translate/batch, and /detect.

# ---------- OCR (OCRAdapter + Redis + llama.cpp) ------------------------------
# Use with: docker compose -f deploy/compose/ocr.yml --env-file .env up
#
# Client entry: http://localhost:${LLM_INIT_PORT}/v1/ocr (async job).
# llm-init proxies to service name ocradapter:8080 (deriveEngineURL).
# OCRAdapter requires Redis (`REDIS_URL`, default redis://redis:6379/0 in compose).
#
#   MODEL_NAME=dots                 # must be OCRAdapter pipeline id (dots|surya2|paddle-hybrid)
#   MODEL_MODE=ocr
#   OCR_PIPELINE=dots               # optional override; empty → MODEL_NAME
#   MODEL_SOURCE=hf://<owner>/<repo> --include <vlm>.gguf
#   # mmproj: prefer ENGINE_ARGS on llamacpp, e.g. --mmproj /models/...
#   ENGINE_ARGS=-ngl all --mmproj /path-or-flags-as-required
#   OCR_ADAPTER_IMAGE=<required production image>
#   # LLAMACPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
#   # REDIS_URL=redis://redis:6379/0
#   # LLAMACPP_URL=http://llamacpp:8081
#   # OCR_LAYOUT_URL=http://layout:8080         # paddle-hybrid only
#   # ocradapter does NOT use WAIT_SENTINEL / run-state; llamacpp.sh still does.
#
# Local integration scripts (llminit):
#   integration_test_ocr_dots.sh / integration_test_ocr_surya2.sh


# ---------- Embed (PureEmbeddingServer) ----------------------------
# Use with: docker compose -f deploy/compose/embed.yml --env-file .env up
#
# PureEmbeddingServer selects models via MODEL_ID (registry id). There is
# no MODEL_NAME env on the engine container. llm-init still requires
# MODEL_NAME = the registry ModelSpec.model_name for that MODEL_ID:
#
#   MODEL_ID (embed)                MODEL_NAME (llm-init, OpenAI alias)
#   embeddinggemma-300m-ov          embeddinggemma-300m
#   embeddinggemma-300m-onnx        embeddinggemma-300m
#   qwen3-embedding-0.6b-int8      qwen3-embedding-0.6b
#
# See PureEmbeddingServer embed_core/src/model/registry.rs (ModelSpec).
#
# EMBED_IMAGE=embed-server:ov-intel-amd64
# MODEL_ID=embeddinggemma-300m-ov
# MODEL_NAME=embeddinggemma-300m
# MODEL_MODE=embedding
# MODEL_SOURCE=hf://google/embeddinggemma-300m
# EMBED_DEVICE=auto
# EMBED_ALLOW_CPU_FALLBACK=1
#
# Unified HF repo (one repo, onnx/ + openvino/ subdirs) — needs --subdir on
# MODEL_SOURCE so model_path points at the format directory, not snapshot root:
#
#   MODEL_ID=embeddinggemma-300m-onnx
#   MODEL_NAME=embeddinggemma-300m
#   MODEL_SOURCE=hf://beclab/embeddinggemma-300m --revision main --exclude "openvino/**" --subdir onnx
#
#   MODEL_ID=embeddinggemma-300m-ov
#   MODEL_NAME=embeddinggemma-300m
#   MODEL_SOURCE=hf://beclab/embeddinggemma-300m --revision main --exclude "onnx/**" --subdir openvino
#
# --exclude/--include control what hf download fetches; --subdir is llm-init-only
# (not passed to hf CLI).

# ---------- Rerank (rerank-server) ---------------------------------
# Use with: docker compose -f deploy/compose/rerank.yml --env-file .env up
#
# rerank-server selects models via MODEL_ID. There is no MODEL_NAME env on
# the engine container. llm-init MODEL_NAME must equal MODEL_ID:
#
#   MODEL_NAME=bge-reranker-v2-m3
#   MODEL_ID=bge-reranker-v2-m3
#   MODEL_MODE=rerank
#   ACCELERATOR=intel-gpu          # or nvidia | nvidia-gb10 | cpu (no auto)
#   RERANK_RUNTIME=openvino        # optional; defaults from ACCELERATOR
#   RERANK_IMAGE=beclab/rerank-server:ov-intel-amd64
#
# Unified HF repo (onnx/ + openvino/ subdirs) — use --subdir on MODEL_SOURCE:
#
#   MODEL_SOURCE='hf://your-org/bge-reranker-v2-m3 --exclude "onnx/**" --subdir openvino'
#   ACCELERATOR=intel-gpu
#   RERANK_RUNTIME=openvino
#
#   MODEL_SOURCE='hf://your-org/bge-reranker-v2-m3 --exclude "openvino/**" --subdir onnx'
#   ACCELERATOR=nvidia
#   RERANK_RUNTIME=onnx
#
# Intel iGPU overlay:
#   docker compose -f deploy/compose/rerank.yml -f deploy/compose/rerank.gpu.yml up

# ---------- ClipEmbed (PureEmbeddingServer, CLIP dual-tower) ----------
# Use with: docker compose -f deploy/compose/clipembed.yml --env-file .env up
#
# Same env contract as Embed; typical Jina CLIP v2 split unified repo:
#
#   MODEL_ID=jina-clip-v2-split-ov
#   MODEL_NAME=jina-clip-v2
#   MODEL_SOURCE=hf://beclab/jina-clip-v2-split --revision main --exclude "onnx/**" --subdir openvino

# How long the wrapper waits for llm-init's sentinel file before
# giving up. Bump this for very large models or slow networks.
WAIT_TIMEOUT=3600

# ---------- shared cache volume contract -----------------------------
# Container paths are FIXED:
#   /cache/hf/hub                 -- HF cache (vllm/llamacpp/sglang/embed)
#   /root/.ollama                 -- Ollama daemon data (ollama)
# Volume source kind/name is configurable. KIND in {volume, bind}.
# SOURCE is a docker named volume name (KIND=volume) or absolute host
# path (KIND=bind). Use a compose override to declare an external volume.
HF_CACHE_KIND=volume
HF_CACHE_SOURCE=hf-hub-cache
OLLAMA_DATA_KIND=volume
OLLAMA_DATA_SOURCE=ollama-data

# ---------- runtime / verification (optional) ------------------------
# VERIFY_LEVEL=size       # how hard a pass checks bytes already on disk before reusing them:
#                         #   size   -- compare lengths (a stat per file)
#                         #   sha256 -- re-hash every file with a recorded digest (a full read)
#                         # `remote` is not accepted here: it reaches the upstream, and a standing
#                         # default that does would give up booting offline. Ask for it one pass at
#                         # a time with POST /api/retry?level=remote.
# VERIFY_ON_DRIFT=report  # what a remote check does when the upstream now serves different bytes:
#                         #   report -- say so on the dashboard, leave the local model alone (default)
#                         #   follow -- download what the upstream serves now
# RUN_DIR=/run/llm-init   # where the sentinel and model_path files live
# MODEL_SPEC_PATH=/run/llm-init/model-spec.json  # resolved spec on disk (default ${RUN_DIR}/model-spec.json); UI edits persist here
# MAX_CONCURRENT_DOWNLOADS=4  # parallel HF tree fan-out; range [1,16], default 4
# RETRY_RATE_LIMIT=1.0        # /api/retry token-bucket refill rate (tokens/sec); 0 disables, default 1.0 (burst 5)
# MAX_DOWNLOAD_BYTES=0        # hard per-URL-download byte cap; 0 = unlimited (default). Bounds cache disk when upstream sends no Content-Length
# (v1.1.0 retired the SSE /api/events stream; the dashboard polls
#  /api/progress every 1 s. MAX_SSE_SUBSCRIBERS is no longer accepted.)

# ---------- logging --------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json
