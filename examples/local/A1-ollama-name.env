# Scenario A1 - Ollama daemon pulls a tag from the Ollama Library.
# Source: ollama:// (no LOCAL needed; daemon owns the bytes).
#
# Run:    bash examples/local/run.sh A1
# Stop:   bash examples/local/run.sh A1 down
# Direct: docker compose -f deploy/compose/ollama.yml \
#           -f examples/local/_spec-chat.compose.yml \
#           --env-file examples/local/A1-ollama-name.env \
#           -p llmlocal-a1 up
#
# UI flow: phase=init -> waiting_engine -> pulling -> ready
#          (the "downloading" bar is driven by /api/pull NDJSON
#          progress, not the hfwrap path)
#
# Verify after ready:
#   curl -s http://localhost:8080/v1/chat/completions \
#     -H 'Content-Type: application/json' \
#     -d '{"model":"qwen3:0.6b","messages":[{"role":"user","content":"hi"}]}'
#   curl -s http://localhost:8080/api/tags | jq      # Ollama-native passthrough
#   curl -s http://localhost:8080/api/ps   | jq

LLM_INIT_IMAGE=llm-init:local
LLM_INIT_PORT=8080

# v1.1.0 unified config. MODEL_MODE seeds the spec; the _spec-chat override
# mounts a fuller spec + MODEL_SPEC_PATH so disk wins over this seed.
MODEL_NAME=qwen3:0.6b
MODEL_MODE=chat
MODEL_SOURCE=ollama://qwen3:0.6b

# Ollama daemon-level env in KEY=VALUE syntax. The wrapper exports
# each token before `ollama serve`; llm-init parses to populate
# Engine.Args.Known so /api/config and the dashboard show the
# effective values.
ENGINE_ARGS=OLLAMA_NUM_CTX=4096 OLLAMA_KEEP_ALIVE=30m

# Companion model spec (mounted via _a1-spec.compose.yml override).
# See examples/local/specs/chat.json for the file contents.

LOG_LEVEL=debug
LOG_FORMAT=text
