# Scenario F1 - Hy-MT2 llama.cpp GGUF translation model.
# Hugging Face currently lists this repository and GGUF file. This is a
# runnable translation-model example, but its download and runtime smoke
# have not been run on this machine.
# This strict-mode example requires llm-init:local; run `make docker` in the
# current checkout first. Do not substitute the published v1.2.1 image. After
# release, replace only TRANSLATE_LLM_INIT_IMAGE with the fixed strict-mode tag.
#
# Run:    bash examples/local/run.sh F1
# Stop:   bash examples/local/run.sh F1 down
# Direct: docker compose -f deploy/compose/translate.yml \
#           -f examples/local/_spec-translate.compose.yml \
#           --env-file examples/local/F1-llamacpp-translate.env \
#           -p llmlocal-f1 up
#
# Verify after ready:
#   curl -s http://localhost:8080/languages | jq
#   curl -s http://localhost:8080/translate \
#     -H 'Content-Type: application/json' \
#     -d '{"from":"es","to":"en","text":"Hola, mundo"}' | jq

TRANSLATE_LLM_INIT_IMAGE=llm-init:local
LLM_INIT_PORT=8080

MODEL_NAME=hy-mt2-1.8b
MODEL_MODE=translate
MODEL_SOURCE=hf://tencent/Hy-MT2-1.8B-GGUF --include Hy-MT2-1.8B-Q4_K_M.gguf

TRANSLATE_LANGUAGES=en,zh-Hans
TRANSLATE_PAIRS=en:zh-Hans,zh-Hans:en

ENGINE_ARGS=-c 2048 -ngl all

HF_ENDPOINT=https://huggingface.co
LLAMACPP_PORT=8081
WAIT_TIMEOUT=600

LOG_LEVEL=debug
LOG_FORMAT=text
