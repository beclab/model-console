# Scenario D1 - intentional failure path: an HF repo that does not exist.
# The hfwrap subprocess exits with a "repo not found" error; lifecycle
# parks at PhaseFailed and surfaces LastError on /api/progress and the
# Overview card. POST /api/retry restarts the attempt; until then the
# control plane and dashboard stay up.
#
# Run:    bash examples/local/run.sh D1
# Stop:   bash examples/local/run.sh D1 down
#
# Observe:
#   curl -s http://localhost:8080/api/progress | jq '.phase, .last_error'
#     # phase = "failed", last_error contains the repo name
#   curl -s -XPOST http://localhost:8080/api/retry
#     # phase flips back to resolving, then failed again

LLM_INIT_IMAGE=llm-init:local
LLM_INIT_PORT=8080

# v1.1.0 unified config. MODEL_MODE seeds the spec; the _spec-chat override
# mounts a fuller spec + MODEL_SPEC_PATH so disk wins over this seed.
MODEL_NAME=ghost-model
MODEL_MODE=chat
MODEL_SOURCE=hf://this-org-does-not-exist/never-published --include ghost.gguf --revision 0000000000000000000000000000000000000000

ENGINE_ARGS=-c 2048

HF_ENDPOINT=https://huggingface.co

LLAMACPP_PORT=8081
WAIT_TIMEOUT=120

LOG_LEVEL=debug
LOG_FORMAT=text
