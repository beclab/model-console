# Scenario A3 - vLLM serves a full HF repo (safetensors + tokenizer).
# Source: hf:// (no --include -> tree-mode fan-out, all weights).
# Requires an NVIDIA GPU on the host.
#
# Run:    bash examples/local/run.sh A3
# Stop:   bash examples/local/run.sh A3 down
# Direct: docker compose -f deploy/compose/vllm.yml \
#           -f examples/local/_spec-chat.compose.yml \
#           --env-file examples/local/A3-vllm-hf-repo.env \
#           -p llmlocal-a3 up
#
# UI flow: phase=init -> resolving -> downloading (multi-file,
#          MAX_CONCURRENT_DOWNLOADS=4 governs fan-out) -> verifying
#          -> waiting_engine (vLLM imports weights to GPU) -> ready
#
# Verify after ready:
#   curl -s http://localhost:8080/v1/chat/completions \
#     -H 'Content-Type: application/json' \
#     -d '{"model":"qwen2.5-0.5b","messages":[{"role":"user","content":"hi"}]}'
#   curl -s http://localhost:8080/api/diag/gpu | jq

LLM_INIT_IMAGE=llm-init:local
LLM_INIT_PORT=8080

# v1.1.0 unified config. MODEL_MODE seeds the spec; the _spec-chat override
# mounts a fuller spec + MODEL_SPEC_PATH so disk wins over this seed.
MODEL_NAME=qwen2.5-0.5b
MODEL_MODE=chat
MODEL_SOURCE=hf://Qwen/Qwen2.5-0.5B-Instruct --revision 7ae557604adf67be50417f59c2c2f167def9a775

# vLLM cmdline. --gpu-memory-utilization and (optionally)
# --cpu-offload-gb replace the v1.0 ENGINE_GPU_MEMORY_UTILIZATION /
# ENGINE_CPU_OFFLOAD_GB env mirrors.
ENGINE_ARGS=--max-model-len 8192 --gpu-memory-utilization 0.85 --cpu-offload-gb 0

HF_ENDPOINT=https://huggingface.co

VLLM_PORT=8000
WAIT_TIMEOUT=1200

MAX_CONCURRENT_DOWNLOADS=4

LOG_LEVEL=debug
LOG_FORMAT=text
