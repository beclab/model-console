# Scenario A2 - llama.cpp serves a single GGUF downloaded from HF.
# Source: hf:// + --include filter (single GGUF).
#
# Run:    bash examples/local/run.sh A2
# Stop:   bash examples/local/run.sh A2 down
# Direct: docker compose -f deploy/compose/llamacpp.yml \
#           -f examples/local/_spec-chat.compose.yml \
#           --env-file examples/local/A2-llamacpp-hf-gguf.env \
#           -p llmlocal-a2 up
#
# UI flow: phase=init -> resolving -> downloading -> verifying -> ready
#          per-file progress card shows the GGUF blob bytes
#
# Verify after ready:
#   curl -s http://localhost:8080/v1/chat/completions \
#     -H 'Content-Type: application/json' \
#     -d '{"model":"qwen2.5-0.5b","messages":[{"role":"user","content":"hi"}]}'

LLM_INIT_IMAGE=llm-init:local
LLM_INIT_PORT=8080

# v1.1.0 unified config. MODEL_MODE seeds the spec; the _spec-chat override
# mounts a fuller spec + MODEL_SPEC_PATH so disk wins over this seed.
MODEL_NAME=qwen2.5-0.5b
MODEL_MODE=chat
MODEL_SOURCE=hf://Qwen/Qwen2.5-0.5B-Instruct-GGUF --include qwen2.5-0.5b-instruct-q4_k_m.gguf --revision 9217f5db79a29953eb74d5343926648285ec7e67

# llama.cpp accepts cmdline OR LLAMA_ARG_*=val env. We use cmdline
# here for readability. -c sets context size, -ngl all puts all
# layers on GPU when available.
ENGINE_ARGS=-c 2048 -ngl all

HF_ENDPOINT=https://huggingface.co

LLAMACPP_PORT=8081
WAIT_TIMEOUT=600

LOG_LEVEL=debug
LOG_FORMAT=text
