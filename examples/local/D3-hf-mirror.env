# Scenario D3 - same model as A2, downloaded through hf-mirror.com.
# Useful from networks where huggingface.co is slow or blocked. The
# wire shape on /api/progress is identical to A2; only the
# `current_url` field in events points at the mirror.
#
# v1.1.0 BREAKING. Pre-1.1 some operators tried to write the mirror
# inline with `MODEL_SOURCE=hf://... --endpoint https://hf-mirror.com`.
# That `--endpoint` flag is now blacklisted at parse time -- use the
# HF_ENDPOINT deployment-level env (this file) instead.
#
# Run:    bash examples/local/run.sh D3
# Stop:   bash examples/local/run.sh D3 down

LLM_INIT_IMAGE=llm-init:local
LLM_INIT_PORT=8080

# v1.1.0 unified config. MODEL_MODE seeds the spec; the _spec-chat override
# mounts a fuller spec + MODEL_SPEC_PATH so disk wins over this seed.
MODEL_NAME=qwen2.5-0.5b-mirror
MODEL_MODE=chat
MODEL_SOURCE=hf://Qwen/Qwen2.5-0.5B-Instruct-GGUF --include qwen2.5-0.5b-instruct-q4_k_m.gguf --revision 9217f5db79a29953eb74d5343926648285ec7e67

ENGINE_ARGS=-c 2048 -ngl all

# Mirror endpoint applies to every hf:// source.
HF_ENDPOINT=https://hf-mirror.com

LLAMACPP_PORT=8081
WAIT_TIMEOUT=600

LOG_LEVEL=debug
LOG_FORMAT=text
