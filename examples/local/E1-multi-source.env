# Scenario E1 - comma-separated preload: one HF model is served while
# a second HF model is downloaded into the shared cache for later use.
#
# Run:    bash examples/local/run.sh E1
# Stop:   bash examples/local/run.sh E1 down
#
# UI flow: phase=init -> resolving -> downloading -> verifying -> ready
#          (single progress bar; multi-file bytes_total is summed up front)
#
# Verify after ready:
#   curl -s http://localhost:8080/v1/chat/completions \
#     -H 'Content-Type: application/json' \
#     -d '{"model":"qwen2.5-0.5b","messages":[{"role":"user","content":"hi"}]}'

LLM_INIT_IMAGE=llm-init:local
LLM_INIT_PORT=8080

MODEL_NAME=qwen2.5-0.5b
MODEL_MODE=chat

# The first source binds llama.cpp. The second is preload-only: it is
# downloaded and counted in progress, but is not served as MODEL_NAME.
MODEL_SOURCE=hf://Qwen/Qwen2.5-0.5B-Instruct-GGUF --include qwen2.5-0.5b-instruct-q4_k_m.gguf --revision 9217f5db79a29953eb74d5343926648285ec7e67,hf://Qwen/Qwen3-0.6B-GGUF --include Qwen3-0.6B-Q8_0.gguf --revision 23749fefcc72300e3a2ad315e1317431b06b590a
MODEL_SOURCE_LOCAL=,

# A vision projector is the third kind of segment: --role mmproj puts it
# next to the main weights in the cache without listing it as an extra.
# The llama.cpp side still needs its own --mmproj pointing at that file,
# which is why this example serves a text model instead.
# MODEL_SOURCE=hf://ggml-org/SmolVLM-Instruct-GGUF --include SmolVLM-Instruct-Q4_K_M.gguf,hf://ggml-org/SmolVLM-Instruct-GGUF --include mmproj-SmolVLM-Instruct-Q8_0.gguf --role mmproj

ENGINE_ARGS=-c 2048 -ngl all

HF_ENDPOINT=https://huggingface.co

LLAMACPP_PORT=8081
WAIT_TIMEOUT=900

LOG_LEVEL=debug
LOG_FORMAT=text
