# Scenario B3 - llama.cpp consumes a GGUF fetched by direct URL.
# No Modelfile needed (llama.cpp loads the GGUF directly), so this is
# the cleanest test of the URL download path under a proxy engine.
#
# Run:    bash examples/local/run.sh B3
# Stop:   bash examples/local/run.sh B3 down
# Direct: docker compose -f deploy/compose/llamacpp.yml \
#           -f examples/local/_spec-chat.compose.yml \
#           --env-file examples/local/B3-llamacpp-url.env \
#           -p llmlocal-b3 up

LLM_INIT_IMAGE=llm-init:local
LLM_INIT_PORT=8080

# v1.1.0 unified config. Pure https:// source for the URL escape hatch
# requires MODEL_SOURCE_LOCAL to specify the on-disk landing path.
MODEL_NAME=qwen2.5-0.5b-url
MODEL_MODE=chat
MODEL_SOURCE=https://huggingface.co/Qwen/Qwen2.5-0.5B-Instruct-GGUF/resolve/main/qwen2.5-0.5b-instruct-q4_k_m.gguf
MODEL_SOURCE_LOCAL=/cache/manual/qwen2.5-0.5b-instruct-q4_k_m.gguf

ENGINE_ARGS=-c 2048 -ngl all

LLAMACPP_PORT=8081
WAIT_TIMEOUT=600

LOG_LEVEL=debug
LOG_FORMAT=text
