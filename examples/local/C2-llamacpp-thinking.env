# Scenario C2 - llama.cpp with a thinking-capable Qwen3 model.
# spec.supports.supports_reasoning=true (in examples/local/specs/thinking.json)
# advertises reasoning on the model card and lets clients pass
# chat_template_kwargs.enable_thinking through to the engine.
#
# Run:    bash examples/local/run.sh C2
# Stop:   bash examples/local/run.sh C2 down
#
# Verify after ready:
#   curl -s http://localhost:8080/v1/chat/completions \
#     -H 'Content-Type: application/json' \
#     -d '{"model":"qwen3-0.6b","messages":[{"role":"user","content":"think step by step: 13*17"}],
#          "chat_template_kwargs":{"enable_thinking":true}}'

LLM_INIT_IMAGE=llm-init:local
LLM_INIT_PORT=8080

# v1.1.0 unified config. MODEL_MODE + MODEL_SUPPORTS seed the spec; the
# _spec-thinking override mounts a fuller spec + MODEL_SPEC_PATH (disk wins).
MODEL_NAME=qwen3-0.6b
MODEL_MODE=chat
MODEL_SUPPORTS=supports_reasoning
MODEL_SOURCE=hf://Qwen/Qwen3-0.6B-GGUF --include Qwen3-0.6B-Q8_0.gguf --revision 23749fefcc72300e3a2ad315e1317431b06b590a

# llama.cpp env-form (LLAMA_ARG_*=val) demonstrates the dual-track
# parsing in deploy/wrappers/llamacpp.sh -- equivalent to the cmdline
# `-c 4096 -ngl all`.
ENGINE_ARGS=LLAMA_ARG_CTX_SIZE=4096 LLAMA_ARG_N_GPU_LAYERS=all

HF_ENDPOINT=https://huggingface.co

LLAMACPP_PORT=8081
WAIT_TIMEOUT=600

LOG_LEVEL=debug
LOG_FORMAT=text
