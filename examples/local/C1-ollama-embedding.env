# Scenario C1 - embedding model on Ollama backend.
# spec.mode=embedding (in examples/local/specs/embedding.json) makes
# /api/endpoints emphasize /v1/embeddings. The data plane is a soft
# catalog: whether the catch-all proxy accepts chat is up to Ollama.
#
# Run:    bash examples/local/run.sh C1
# Stop:   bash examples/local/run.sh C1 down
#
# Verify after ready:
#   curl -s http://localhost:8080/v1/embeddings \
#     -H 'Content-Type: application/json' \
#     -d '{"model":"nomic-embed-text","input":"hello world"}'
#   curl -s http://localhost:8080/api/endpoints | jq

LLM_INIT_IMAGE=llm-init:local
LLM_INIT_PORT=8080

# v1.1.0 unified config. MODEL_MODE=embedding seeds the spec; the
# _spec-embedding override mounts a fuller spec + MODEL_SPEC_PATH (disk wins).
MODEL_NAME=nomic-embed-text
MODEL_MODE=embedding
MODEL_SOURCE=ollama://nomic-embed-text

# Embedding workloads typically don't need many slots or a long ctx.
ENGINE_ARGS=OLLAMA_NUM_CTX=2048 OLLAMA_KEEP_ALIVE=30m OLLAMA_NUM_PARALLEL=4

LOG_LEVEL=debug
LOG_FORMAT=text
