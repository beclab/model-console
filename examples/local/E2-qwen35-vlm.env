# Scenario E2 - Ollama: comma-separated MODEL_SOURCE pulls main GGUF + mmproj URL.
# First segment (main) is registered as MODEL_NAME via /api/blobs + /api/create.
# Second segment (extra) is downloaded to url-fetched/ only; llm-init does NOT
# attach mmproj to the Ollama daemon (unlike llama.cpp --mmproj).
#
# Run:    bash examples/local/run.sh E2
# Stop:   bash examples/local/run.sh E2 down
#
# UI: download bar should show bytes_total ~= sum of both GGUFs from the start
#     (HF Hub tree API for huggingface.co/.../resolve/... URLs), not jump when
#     the second file begins. Dashboard uses decimal GB (matches HF: 3.19 GB
#     main + 0.92 GB mmproj ~= 4.1 GB total for E2).
#
# Verify after ready:
#   curl -s http://localhost:8080/v1/chat/completions \
#     -H 'Content-Type: application/json' \
#     -d '{"model":"qwen3.5-9b-vlm","messages":[{"role":"user","content":"hi"}]}'

LLM_INIT_IMAGE=llm-init:local
LLM_INIT_PORT=8080

MODEL_NAME=qwen3.5-9b-vlm
MODEL_MODE=chat
MODEL_SUPPORTS=supports_vision

MODEL_SOURCE=ollama://https://huggingface.co/unsloth/Qwen3.5-9B-GGUF/resolve/main/Qwen3.5-9B-UD-IQ2_XXS.gguf,ollama://https://huggingface.co/unsloth/Qwen3.5-9B-GGUF/resolve/main/mmproj-BF16.gguf
MODEL_SOURCE_LOCAL=,

ENGINE_ARGS=OLLAMA_NUM_CTX=4096 OLLAMA_KEEP_ALIVE=30m

WAIT_TIMEOUT=7200

LOG_LEVEL=debug
LOG_FORMAT=text
