# Scenario B2 - Ollama backend, GGUF pulled by direct URL (no HF tree
# resolution). Exercises the URL branch + optional SHA256 verification
# before /api/blobs upload.
#
# Run:    bash examples/local/run.sh B2
# Stop:   bash examples/local/run.sh B2 down
#
# To exercise the SHA256-mismatch failure path, replace the #sha256=...
# fragment with a wrong hex string and watch /api/progress's
# last_error -> "fetch: sha256 mismatch".

LLM_INIT_IMAGE=llm-init:local
LLM_INIT_PORT=8080

# v1.1.0 unified config. ollama:// URL-overload form: llm-init range-
# downloads, ollama daemon registers via /api/blobs + /api/create.
# Optional sha256 fragment verifies the bytes pre-upload.
MODEL_NAME=qwen2.5-0.5b-url
MODEL_MODE=chat
MODEL_SOURCE=ollama://https://huggingface.co/Qwen/Qwen2.5-0.5B-Instruct-GGUF/resolve/main/qwen2.5-0.5b-instruct-q4_k_m.gguf

ENGINE_ARGS=OLLAMA_NUM_CTX=4096 OLLAMA_KEEP_ALIVE=30m

LOG_LEVEL=debug
LOG_FORMAT=text
