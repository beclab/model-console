# Scenario B1 - Ollama backend, but bytes come from a HF single GGUF
# (NOT the Ollama Library). llm-init downloads the GGUF, POSTs it to
# /api/blobs, then /api/create with a from-only Modelfile (FROM <blob>).
# Modern GGUFs self-describe their chat template via metadata, so no
# template/system/parameter injection is needed.
#
# (Pre-v1.1.0 this scenario also set GGUF_TEMPLATE_NAME / GGUF_SYSTEM
# env. Those are removed -- the GGUF metadata is authoritative.)
#
# Run:    bash examples/local/run.sh B1
# Stop:   bash examples/local/run.sh B1 down
#
# UI flow: phase=init -> resolving -> downloading -> registering
#          (Modelfile create) -> ready

LLM_INIT_IMAGE=llm-init:local
LLM_INIT_PORT=8080

# v1.1.0 unified config. Use ollama:// URL-overload form to express
# "Ollama backend, but the bytes are this HF GGUF". Auto-detection on
# the body sees the dot+slash and treats it as a URL.
MODEL_NAME=qwen2.5-0.5b-local
MODEL_MODE=chat
MODEL_SOURCE=ollama://https://huggingface.co/Qwen/Qwen2.5-0.5B-Instruct-GGUF/resolve/9217f5db79a29953eb74d5343926648285ec7e67/qwen2.5-0.5b-instruct-q4_k_m.gguf

ENGINE_ARGS=OLLAMA_NUM_CTX=4096 OLLAMA_KEEP_ALIVE=30m

HF_ENDPOINT=https://huggingface.co

LOG_LEVEL=debug
LOG_FORMAT=text
