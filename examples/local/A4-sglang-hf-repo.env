# Scenario A4 - SGLang serves a full HF repo. Same shape as A3 but
# the reverse proxy targets the lmsysorg/sglang container.
# Requires an NVIDIA GPU; CPU mode for SGLang is not a supported path.
#
# Run:    bash examples/local/run.sh A4
# Stop:   bash examples/local/run.sh A4 down
# Direct: docker compose -f deploy/compose/sglang.yml \
#           -f examples/local/_spec-chat.compose.yml \
#           --env-file examples/local/A4-sglang-hf-repo.env \
#           -p llmlocal-a4 up
#
# Verify after ready:
#   curl -s http://localhost:8080/v1/chat/completions \
#     -H 'Content-Type: application/json' \
#     -d '{"model":"qwen2.5-0.5b","messages":[{"role":"user","content":"hi"}]}'

LLM_INIT_IMAGE=llm-init:local
LLM_INIT_PORT=8080

# v1.1.0 unified config. MODEL_MODE seeds the spec; the _spec-chat override
# mounts a fuller spec + MODEL_SPEC_PATH so disk wins over this seed.
MODEL_NAME=qwen2.5-0.5b
MODEL_MODE=chat
MODEL_SOURCE=hf://Qwen/Qwen2.5-0.5B-Instruct --revision 7ae557604adf67be50417f59c2c2f167def9a775

# SGLang cmdline. --mem-fraction-static is SGLang's GPU memory knob
# (analogue to vLLM's --gpu-memory-utilization).
ENGINE_ARGS=--context-length 8192 --mem-fraction-static 0.8 --max-running-requests 32

HF_ENDPOINT=https://huggingface.co

SGLANG_PORT=30000
WAIT_TIMEOUT=1200

MAX_CONCURRENT_DOWNLOADS=4

LOG_LEVEL=debug
LOG_FORMAT=text
